{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsidian Hub 2 Preview",
  "version": "2.1.0-preview.1",
  "identifier": "io.github.obsidian-hub.v2preview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Obsidian Hub 2 Preview",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../apps/bridge/manifest.json": "bridge/manifest.json",
      "../apps/bridge/main.js": "bridge/main.js",
      "../apps/bridge/styles.css": "bridge/styles.css"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RTY5MjkxMTdEMjM3QjUKUldTMU45SVhrWkxtK2ZkOTBXSXZ5S2p4SGFuOXB6SHpFc3paQ3hudm5zYUtwbWlXNTVuOGVNTEkK",
      "endpoints": [
        "https://github.com/LeeDaud/Obsidian-Hub/releases/download/v2-preview-channel/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
