{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsidian Hub",
  "version": "0.2.0",
  "identifier": "io.github.obsidian-hub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Obsidian Hub",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../apps/bridge/manifest.json": "bridge/manifest.json",
      "../apps/bridge/main.js": "bridge/main.js",
      "../apps/bridge/styles.css": "bridge/styles.css"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
